*.sql
*.sql.gz
*.zip
*.tar
*.tar.gz
backup/
backups/

# WordPress : ni le coeur, ni les plugins tiers, ni les medias ne sont notre code
wp-admin/
wp-includes/
wp-content/uploads/
wp-content/cache/
wp-content/upgrade/
wp-content/plugins/

# Copies de travail lues mais jamais versionnees : code de plugins tiers deposes
# pour inspection, exports, captures. Rien de ce dossier ne part sur GitHub.
.local/

